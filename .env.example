# ============================================================
#  Travel Agent — API keys
#  복사해서 .env 로 저장하고 값을 채우세요:  cp .env.example .env
#  필수는 ANTHROPIC_API_KEY 하나뿐. 나머지는 없으면 자동으로
#  mock/스킵 처리되므로 단계적으로 켜면 됩니다.
# ============================================================

# [필수] LLM — https://console.anthropic.com  (유료, 사용량 과금)
ANTHROPIC_API_KEY=

# [무료] 날씨 = Open-Meteo : 키 불필요 (코드에 키 안 씀)
# [무료] 지오코딩 = Nominatim/OSM : 키 불필요
# [무료] 맛집·카페·관광 = Overpass/OSM : 키 불필요

# [무료] 동선 최적화 — https://openrouteservice.org/dev (가입 후 무료, 2,000회/일)
ORS_API_KEY=

# [무료] 감성 영상 — https://console.cloud.google.com (YouTube Data API v3, 1만 유닛/일 무료)
YOUTUBE_API_KEY=

# [무료티어] 감성 웹 — https://tavily.com (1,000회/월 무료)
TAVILY_API_KEY=

# [무료] 로컬 후기 — https://www.reddit.com/prefs/apps (개인용 무료)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# [유료] 항공권 실시간 가격 — 키 없으면 자동 mock + 검색링크로 동작 ($0)
#   실시간 가격이 꼭 필요할 때만. 예산: 제공사별 상이, 보통 월 $30~ 부터
FLIGHT_API_KEY=
